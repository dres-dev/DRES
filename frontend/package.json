{
  "name": "dres-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "pbuild": "ng build --configuration production --output-path=build/dist",
    "test": "ng test",
    "lint:ts": "eslint --ext \".ts\" --ignore-path .gitignore",
    "lint:style": "stylelint \"**/*.{css,scss,sass}\" --ignore-path .gitignore --ignore-pattern \"build/**\"",
    "lint:prettier": "prettier --check --config .prettierrc.json --ignore-unkown .",
    "lint": "yarn lint:ts && yarn lint:style && yarn lint:prettier",
    "lintfix": "prettier --write --list-different --ignore-unknown . && yarn lint:ts --fix",
    "prepare": "husky",
    "postinstall": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --cache"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "angularx-qrcode": "20.0.0",
    "apexcharts": "3.x",
    "ng-apexcharts": "1.x",
    "ngx-color-picker": "^14.0.0",
    "rxjs": "7.x",
    "tslib": "2.x",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.26",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@angular/language-service": "21.2.25",
    "@types/jasmine": "3.6.x",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "8.x",
    "@typescript-eslint/parser": "8.x",
    "eslint": "^8.12.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "jasmine-core": "3.8.x",
    "jasmine-spec-reporter": "5.0.x",
    "karma": "6.4.x",
    "karma-chrome-launcher": "3.2.x",
    "karma-coverage-istanbul-reporter": "3.0.x",
    "karma-jasmine": "4.0.x",
    "karma-jasmine-html-reporter": "1.5.x",
    "lint-staged": "^12.3.7",
    "prettier": "3.x",
    "prettier-eslint": "^16.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-scss": "^1.0.0-security",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-node": "10.x",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.18.1"
}
